{
  "name": "psyq-wasm",
  "version": "0.2.0",
  "description": "PsyQ 4.4 cc1psx (GCC 2.8.1, mips-psx) compiled to WebAssembly, for byte-exact PlayStation 1 matching-decompilation tooling in the browser and Node.js",
  "keywords": [
    "psyq",
    "cc1psx",
    "gcc",
    "mips",
    "playstation",
    "ps1",
    "psx",
    "decompilation",
    "webassembly",
    "wasm",
    "emscripten"
  ],
  "homepage": "https://github.com/jaysonvirissimo/psyq-wasm#readme",
  "bugs": {
    "url": "https://github.com/jaysonvirissimo/psyq-wasm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaysonvirissimo/psyq-wasm.git"
  },
  "license": "MIT AND GPL-2.0-only",
  "author": "Jayson Virissimo",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "LICENSE",
    "LICENSES/",
    "PROVENANCE.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/index.node.js",
      "default": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./worker.node": "./dist/worker.node.js",
    "./cc1psx.wasm": "./dist/cc1psx.wasm",
    "./cccp.wasm": "./dist/cccp.wasm",
    "./package.json": "./package.json"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:node": "vitest run --project node",
    "test:browser": "playwright test",
    "test:package": "node test/package/run.mjs",
    "build:vendor": "build/fetch-vendor.sh",
    "build:wasm": "build/build-wasm.sh",
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:wasm && npm run build:ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.9.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
