# Pinned inputs for the psyq-wasm compiler build. Every value here is part of
# the reproducible-build record (see PROVENANCE.md). Changing any value
# requires re-running the full differential test suite.
#
# Format: KEY=value, optional double quotes. Sourced by build/lib.sh and
# parsed by test/helpers/pins.ts.

# Compiler source: reconstructed PsyQ 4.4 cc1psx (GCC 2.8.1, mips-psx).
HOMEBREW_PSYQ_REPO=https://github.com/nocato/homebrew-psyq
HOMEBREW_PSYQ_SHA=bdee891005a0aec6bf6fe40e504cf068ebf38caf
HOMEBREW_PSYQ_VERSION=0.2.0
GCC_SUBDIR=gcc-2.8.1_psyq-4.4
# git tree object of $GCC_SUBDIR at $HOMEBREW_PSYQ_SHA (`git rev-parse <sha>:<subdir>`).
GCC_TREE_SHA=5331d55810156d0634e7c01d916aaa48e57253ad

# Historical Linux environment (Debian 2.1 "slink", i386) used to build the
# reference compiler and to generate the GCC build-time sources in build/gen.
SLINK_IMAGE=docker.io/debian/eol@sha256:50b8edf5ebbc6a6e266cf6972c32ac6ecb293222d82f6f191dc4a7df49f217ba
SLINK_PLATFORM=linux/386
# gcc 2.7.2.3, autoconf 2.12, libc6-dev 2.0.7, make 3.77, bison 1.25, gperf 2.7
SLINK_PACKAGES="gcc autoconf libc6-dev make bison gperf"

# Emscripten toolchain used to build cc1psx.wasm.
# Emscripten 6.0.9, immutable amd64 image manifest.
EMSDK_IMAGE=emscripten/emsdk@sha256:3ba391c5b1554e06f9af0a69652ff20919dff14e771619339dba988bd62574b5
EMSDK_PLATFORM=linux/amd64

TARGET_NAME=mips-psx
CC1_VERSION_BANNER="GNU C version 2.8.1, Psy-Q 4.4, Homebrew Psy-Q 0.2.0 (mips-psx) compiled by GNU C version 2.7.2.3."
# Printed by `cccp -v`; the preprocessor is built from the same sources.
CPP_VERSION_BANNER="GNU CPP version 2.8.1, Psy-Q 4.4, Homebrew Psy-Q 0.2.0 [AL 1.1, MM 40] Sony Playstation"

# Per-object compile flags. Conservative settings for 1990s C.
# (Not named EMCC_CFLAGS: Emscripten reads that environment variable and
# appends it to every invocation, including the link step.)
CC1_WASM_CFLAGS="-O2 -flto -std=gnu89 -fno-strict-aliasing -fwrapv -DCROSS_COMPILE -DIN_GCC -DHAVE_CONFIG_H -Wno-everything"

# Link flags. EMULATE_FUNCTION_POINTER_CASTS is required: GCC 2.8.1 calls
# K&R-style callbacks through mismatched function-pointer types, which traps
# under WebAssembly's strict indirect-call signature checks.
#
# The link step uses -O1: the Binaryen snapshot bundled with emsdk 6.0.x
# (wasm-opt 132-49-gd03c25ea4) aborts on an internal assertion when it runs the
# -O2 pass pipeline after --fpcast-emu on this module. Objects are still
# compiled at -O2 with LTO; the -O1 link output is byte-exact against the
# reference compiler on the whole fixture set and no slower than -O2.
CC1_WASM_LDFLAGS="-O1 -flto -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB -sSTACK_SIZE=16MB -sEXIT_RUNTIME=1 -sFORCE_FILESYSTEM=1 -sENVIRONMENT=web,worker,node -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME=createCc1 -sINVOKE_RUN=0 -sEXPORTED_RUNTIME_METHODS=FS,callMain,ENV -sEMULATE_FUNCTION_POINTER_CASTS=1"

# The preprocessor (dist/cccp.js) links with the same flags under its own export name.
CCCP_WASM_LDFLAGS="-O1 -flto -sALLOW_MEMORY_GROWTH=1 -sINITIAL_MEMORY=64MB -sSTACK_SIZE=16MB -sEXIT_RUNTIME=1 -sFORCE_FILESYSTEM=1 -sENVIRONMENT=web,worker,node -sMODULARIZE=1 -sEXPORT_ES6=1 -sEXPORT_NAME=createCccp -sINVOKE_RUN=0 -sEXPORTED_RUNTIME_METHODS=FS,callMain,ENV -sEMULATE_FUNCTION_POINTER_CASTS=1"
